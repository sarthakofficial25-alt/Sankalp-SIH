# ============================================
# SURAKSHA-NET Environment Configuration
# ============================================

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=suraksha-net-demo-secret-key-change-in-production
JWT_EXPIRY=24h

# Database (for future PostgreSQL migration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=suraksha_net
