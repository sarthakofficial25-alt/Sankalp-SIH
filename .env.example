# ============================================
# IBVAP Environment Configuration
# Intelligent Border Video Analytics Platform
# ============================================

# Server
PORT=3001
NODE_ENV=development

# JWT — MUST set a strong, unique secret in production
JWT_SECRET=<REPLACE_WITH_STRONG_RANDOM_SECRET>
JWT_EXPIRY=24h

# Database (for future PostgreSQL migration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibvap
DB_USER=<REPLACE_WITH_DB_USERNAME>
DB_PASSWORD=<REPLACE_WITH_STRONG_DB_PASSWORD>

# AI Engine
AI_ENGINE_URL=http://localhost:5000
AI_ENGINE_ENABLED=false

# CORS — restrict to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Client
VITE_API_URL=http://localhost:3001/api
